# backend/.env
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/cymor-vcf
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development
JOIN_PER_IP_HOUR=5
# Optional: Cloudflare Turnstile secret enables CAPTCHA on join
CAPTCHA_SECRET=
# Optional: Resend key sends real emails (otherwise logged to console)
RESEND_API_KEY=
MAIL_FROM=CYMOR VCF <no-reply@yourdomain.com>
# Seed script
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Turnstile site key (must match backend CAPTCHA_SECRET)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
